{
  "name": "tether-password-manager",
  "productName": "TetherPass",
  "version": "1.0.0",
  "upgrade": "pear://zmc1uz3cqetqk7dyqcyih5tph39osw8njhxuaxjzmftca9zksshy",
  "description": "Peer-to-peer password manager built on Pear and Autopass",
  "license": "MIT",
  "author": "Igor",
  "type": "commonjs",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,app \"vite\" \"wait-on tcp:5173 && cross-env PEAR_DEV_SERVER_URL=http://localhost:5173 electron-forge start -- --no-updates\"",
    "build:ui": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "prestart": "npm run build:ui",
    "prepackage": "npm run build:ui",
    "premake": "npm run build:ui",
    "inline-worker": "inline-worker-module hello-pear-worker",
    "lint": "prettier --check . && lunte",
    "format": "prettier --write . && lunte --fix",
    "start": "electron-forge start -- --no-updates",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:mas": "electron-forge make --platform=mas",
    "install:all": "npm i --ignore-scripts=true && npm run postinstall:all",
    "install:mac": "npm i --ignore-scripts=true && npm run postinstall:mac",
    "postinstall:all": "npm run install:electron",
    "postinstall:mac": "npm run postinstall:all && npm run install:macos-alias && npm run install:fs-xattr",
    "install:electron": "node node_modules/electron/install.js",
    "install:macos-alias": "cd node_modules/macos-alias && node-gyp rebuild",
    "install:fs-xattr": "cd node_modules/fs-xattr && node-gyp rebuild"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "autopass": "^3.4.1",
    "bare-fs": "^4.8.4",
    "bare-path": "^3.1.2",
    "bare-storage": "^1.1.0",
    "corestore": "^7.15.0",
    "framed-stream": "^1.0.1",
    "graceful-goodbye": "^1.3.3",
    "hyperswarm": "^4.17.2",
    "paparam": "^1.10.0",
    "pear-mobile": "^4.3.0",
    "pear-runtime": "^1.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.0",
    "which-runtime": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-msix": "^7.11.1",
    "@electron-forge/maker-pkg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron/node-gyp": "git+ssh://git@github.com/electron/node-gyp.git#06b29aafb7708acef8b3669835c8a7857ebc92d2",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "app-builder-lib": "^26.8.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^40.2.1",
    "electron-forge-plugin-prune-prebuilds": "^1.0.2",
    "electron-forge-plugin-universal-prebuilds": "^1.0.0",
    "hello-pear-worker": "^1.2.0",
    "inline-worker-module": "^1.0.0",
    "lunte": "^1.6.0",
    "pear-electron-forge-maker-appimage": "^2.0.0",
    "pear-electron-forge-maker-flatpak": "^0.0.6",
    "pear-electron-forge-maker-snap": "^1.0.0",
    "prettier": "^3.8.1",
    "prettier-config-holepunch": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "electron@40.10.1": true,
    "electron-winstaller": false
  },
  "imports": {
    "pear-runtime": {
      "ios": "pear-mobile",
      "android": "pear-mobile",
      "simulator": "pear-mobile",
      "default": "pear-runtime"
    }
  }
}
